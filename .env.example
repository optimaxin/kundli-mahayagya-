# Frontend configuration (copy to .env.local). Only VITE_* values reach the browser -- never put secrets here.

# Base URL of the backend API as seen by the browser. Default: same origin (/api/v1), which works with
# the dev proxy below and with a production reverse proxy that serves /api from the backend.
VITE_API_BASE_URL=/api/v1

# Dev server only: where `npm run dev` forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
