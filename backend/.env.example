# =====================================================================
# 2151 Kundiya Mahayagya API - environment configuration TEMPLATE
# Copy to .env (never commit .env). All values below are placeholders.
# =====================================================================

# --- Application -------------------------------------------------------
# development | test | production
APP_ENV=development
# set false in production if docs must not be public
ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (local Docker PostgreSQL by default) ---------------------
# Local:     postgresql+psycopg://mahayagya:mahayagya@localhost:5432/mahayagya
# Supabase:  see docs/deployment.md ("Connecting Supabase"). Use the pooler
#            connection string; with the transaction pooler (port 6543) also
#            set DB_DISABLE_PREPARED_STATEMENTS=true.
DATABASE_URL=postgresql+psycopg://mahayagya:mahayagya@localhost:5432/mahayagya
# Optional: direct/session-mode URL used only for migrations.
MIGRATIONS_DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_DISABLE_PREPARED_STATEMENTS=false

# --- Supabase (provided later; leave empty until then) -----------------
# The backend only needs DATABASE_URL. These are placeholders for future
# Supabase features. NEVER expose SUPABASE_SERVICE_ROLE_KEY to a browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security (REQUIRED in production) ---------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
SCANNER_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated list of allowed browser origins (the React + Vite site).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=*
# true when served over HTTPS
ENABLE_HSTS=false

# --- Rate limiting / admission control ---------------------------------
RATE_LIMIT_ENABLED=true
# memory | redis (use redis with >1 instance)
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_REGISTRATION=10/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASS_LOOKUP=10/minute
RATE_LIMIT_PUBLIC_READ=120/minute
RATE_LIMIT_SCANNER=600/minute
RATE_LIMIT_SCANNER_MANUAL=60/minute
ANALYTICS_CACHE_SECONDS=10
# per worker process
REGISTRATION_MAX_CONCURRENCY=16
REGISTRATION_MAX_QUEUE=200
REGISTRATION_QUEUE_TIMEOUT_SECONDS=10

# --- Event rules -------------------------------------------------------
EVENT_TIMEZONE=Asia/Kolkata
BOOKING_CUTOFF_MINUTES=60
ENFORCE_CHECKIN_WINDOW=true
CHECKIN_OPENS_MINUTES_BEFORE=15
CHECKIN_CLOSES_MINUTES_AFTER=15
REQUIRE_IDEMPOTENCY_KEY=true
IDEMPOTENCY_TTL_HOURS=24
ENFORCE_UNIQUE_MOBILE_PER_SESSION=true

# --- Reports -----------------------------------------------------------
REPORTS_DIR=./var/reports

# --- Offline venue node (only on the venue local server) ---------------
OFFLINE_NODE_MODE=false
OFFLINE_NODE_ID=
CLOUD_API_BASE_URL=
CLOUD_SYNC_EMAIL=
CLOUD_SYNC_PASSWORD=

# --- Docker Compose (local database container) -------------------------
POSTGRES_DB=mahayagya
POSTGRES_USER=mahayagya
POSTGRES_PASSWORD=mahayagya
POSTGRES_PORT=5432
